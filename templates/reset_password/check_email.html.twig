{% extends 'base/single.column.html.twig' %}

{% set title %}Check your email{% endset %}

{% block body %}
    <p>
        If <strong>{{ email }}</strong> belongs to an account, we've sent it a link to choose a new password.
        The link works once and expires in an hour.
    </p>
    <p class="text-muted">
        Nothing arrived after a few minutes? Check your spam folder or <a href="{{ path('forgot_password_request') }}">try again</a>.
    </p>
{% endblock %}
