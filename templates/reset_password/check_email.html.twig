{% extends 'base/single.column.html.twig' %}

{% set title %}{{ 'Check your email'|trans }}{% endset %}

{% block body %}
    <p>
        {{ 'If <strong>{email}</strong> belongs to an account, we\'ve sent it a link to choose a new password.'|trans({email: email|e})|raw }}
        {{ 'The link works once and expires in an hour.'|trans }}
    </p>
    <p class="text-muted">
        {{ 'Nothing arrived after a few minutes? Check your spam folder or <a href="{url}">try again</a>.'|trans({url: path('forgot_password_request')})|raw }}
    </p>
{% endblock %}
