{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% block body %}
    <p>A reminder: <strong>{{ event }}</strong> is coming up and you are subscribed.</p>
    {{ include('email/event/_details.html.twig') }}
    <p>Can't make it anymore? Please unsubscribe on the event page, so the organisers know.</p>
    {{ email.button(url('event_event_show', {id: event.id}), 'View event') }}
{% endblock %}
