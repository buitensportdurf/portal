{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% block body %}
    <p>You are subscribed to <strong>{{ event }}</strong>.</p>
    {{ include('email/event/_details.html.twig') }}
    <p>The attached calendar file adds it to your agenda. Plans changed? You can change or cancel your subscription on the event page.</p>
    {{ email.button(url('event_event_show', {id: event.id}), 'View event') }}
{% endblock %}
