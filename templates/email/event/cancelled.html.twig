{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% block body %}
    <p>
        Unfortunately <strong>{{ event }}</strong> on {{ event.startDate|fdate_time }}, which you subscribed to,
        has been cancelled.
    </p>
    {{ email.button(url('event_event_show', {id: event.id}), 'View event') }}
{% endblock %}
