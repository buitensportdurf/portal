{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title %}You already have an account{% endset %}

{% block body %}
    <p>
        Someone (hopefully you) tried to sign up on the Buitensport Durf member portal with this email address,
        but you already have an account: <strong>{{ user.username }}</strong>.
    </p>
    <p>You can log in with that username or this email address.</p>
    {{ email.button(url('login'), 'Log in') }}
    <p>Forgot your password? <a href="{{ url('forgot_password_request') }}" style="color: #32373c;">Reset it here</a>.</p>
{% endblock %}
