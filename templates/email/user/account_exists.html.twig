{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title = 'You already have an account'|trans %}

{% block body %}
    <p>{{ 'Someone (hopefully you) tried to sign up on the Buitensport Durf member portal with this email address, but you already have an account: <strong>{username}</strong>.'|trans({username: user.username|e})|raw }}</p>
    <p>{{ 'You can log in with that username or this email address.'|trans }}</p>
    {{ email.button(url('login'), 'Log in'|trans) }}
    <p>{{ 'Forgot your password? <a href="{url}" style="color: #32373c;">Reset it here</a>.'|trans({url: url('forgot_password_request')|e})|raw }}</p>
{% endblock %}
