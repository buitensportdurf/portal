{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title = 'Confirm your new email address'|trans %}

{% block body %}
    <p>{{ 'You asked to change the email address of your account <strong>{username}</strong> to <strong>{email}</strong>. Confirm it with the button below (you may have to log in first).'|trans({username: user.username|e, email: newEmail|e})|raw }}</p>
    {{ email.button(confirmUrl, 'Confirm this address'|trans) }}
    <p>{{ "The link expires in a day. Didn't ask for this? Then you can ignore this email; nothing changes."|trans }}</p>
{% endblock %}
