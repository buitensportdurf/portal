{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title %}Reset your password{% endset %}

{% block body %}
    <p>Someone (hopefully you) asked to reset the password of your account <strong>{{ user.username }}</strong>.</p>
    {{ email.button(url('reset_password', {token: resetToken}), 'Choose a new password') }}
    <p>The link works once and expires in an hour. Didn't ask for this? Then you can ignore this email.</p>
{% endblock %}
