{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title = 'Reset your password'|trans %}

{% block body %}
    <p>{{ 'Someone (hopefully you) asked to reset the password of your account <strong>{username}</strong>.'|trans({username: user.username|e})|raw }}</p>
    {{ email.button(url('reset_password', {token: resetToken}), 'Choose a new password'|trans) }}
    <p>{{ "The link works once and expires in an hour. Didn't ask for this? Then you can ignore this email."|trans }}</p>
{% endblock %}
