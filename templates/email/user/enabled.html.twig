{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title %}Account activated{% endset %}

{% block body %}
    <p>Your account on the Buitensport Durf member portal is now active.</p>
    <p>You can log in with your username <strong>{{ user.username }}</strong> or your email address, and subscribe to events.</p>
    {{ email.button(url('login'), 'Log in') }}
{% endblock %}
