{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title %}Your password was changed{% endset %}

{% block body %}
    <p>The password of your account <strong>{{ user.username }}</strong> was just changed.</p>
    <p>
        Was this you? Then you don't need to do anything. If it wasn't, reset your password right away and let the
        committee know.
    </p>
    {{ email.button(url('forgot_password_request'), 'Reset my password') }}
{% endblock %}
