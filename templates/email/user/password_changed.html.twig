{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title = 'Your password was changed'|trans %}

{% block body %}
    <p>{{ 'The password of your account <strong>{username}</strong> was just changed.'|trans({username: user.username|e})|raw }}</p>
    <p>{{ "Was this you? Then you don't need to do anything. If it wasn't, reset your password right away and let the committee know."|trans }}</p>
    {{ email.button(url('forgot_password_request'), 'Reset my password'|trans) }}
{% endblock %}
