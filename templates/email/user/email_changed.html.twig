{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as email %}

{% set title = 'Your email address was changed'|trans %}

{% block body %}
    <p>{{ 'The email address of your account <strong>{username}</strong> was changed to <strong>{email}</strong>. We send this to your old address so you know.'|trans({username: user.username|e, email: user.email|e})|raw }}</p>
    <p>{{ "Was this you? Then you don't need to do anything. If it wasn't, contact the committee right away."|trans }}</p>
{% endblock %}
