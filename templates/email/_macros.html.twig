{% macro button(url, label) %}
    <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 16px 0;">
        <tr>
            <td style="border-radius: 6px; background: #32373c;">
                <a href="{{ url }}" style="display: inline-block; padding: 10px 18px; color: #ffffff; text-decoration: none; font-weight: 600;">{{ label }}</a>
            </td>
        </tr>
    </table>
    <p style="margin: 0 0 12px; font-size: 13px; color: #6c757d;">{{ 'Button not working? Copy this link: <a href="{url}" style="color: #6c757d; word-break: break-all;">{url}</a>'|trans({url: url|e})|raw }}</p>
{% endmacro %}
