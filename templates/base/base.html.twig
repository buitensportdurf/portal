<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title is defined %}{{ title }}{% else %}{{ 'Durf member portal'|trans }}{% endif %}</title>
    <link rel="shortcut icon" type="image/jpg" href="/favicon.svg">

    {% block css %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css">
        {# Plain stylesheet instead of the kit loader script: the kit injected its CSS after the page rendered, so icons popped in late #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
              integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
              crossorigin="anonymous" referrerpolicy="no-referrer">
        <link rel="stylesheet" href="{{ asset('css/durf.css') }}">
    {% endblock %}
</head>
<body class="bg-light">
{{ include('base/navbar.html.twig') }}

<div class="container">
    <div class="row">
        <div class="col-sm mx-auto">
            {% block flashes %}
                {% for msg in app.session.flashBag.get('error') %}
                    <div class="alert alert-danger my-2" role="alert">
                        {{ msg|trans }}
                    </div>
                {% endfor %}
                {% for msg in app.session.flashBag.get('success') %}
                    <div class="alert alert-success my-2">
                        {{ msg|trans }}
                    </div>
                {% endfor %}
            {% endblock %}
        </div>
    </div>
</div>

{% block content %}
{% endblock %}

<div class="container-fluid bg-light">
    <div class="container">
        <div class="row my-3">
            <div class="col-sm mx-auto">
                {{ include('base/footer.html.twig') }}
            </div>
        </div>
    </div>
</div>

{% block js %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
</body>
</html>
