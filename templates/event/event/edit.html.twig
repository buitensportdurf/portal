{% extends 'base/single.column.html.twig' %}

{% set title %}{{ 'Edit {event}'|trans({event: event}) }}{% endset %}

{% block actions %}
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-primary" href="{{ path('event_event_index') }}">{{ 'Back to list'|trans }}</a>
        <a class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteEvent">{{ 'Delete'|trans }}</a>
        {{ include('components/_confirm_modal.html.twig', {
            id: 'confirmDeleteEvent',
            title: 'Delete event'|trans,
            message: 'Are you sure you want to delete event "{event}"?'|trans({event: event}),
            action_url: path('event_event_delete', {id: event.id}),
            csrf_id: 'event-delete',
            action_label: 'Delete'|trans,
        }) }}
    </div>
{% endblock %}

{% block body %}
    {% if event.recurringEvent %}
        <div class="alert alert-info">
            <i class="fas fa-redo"></i>
            {{ 'This event is part of <strong>{series}</strong>. Changes here only apply to this event, and the fields you change stop following the series.'|trans({series: event.recurringEvent|e})|raw }}
            {% if is_granted('ROLE_EVENT_RECURRING') and event.occurrenceStart %}
                {{ 'To change more events, edit <a href="{following_url}">this and following events</a> or <a href="{series_url}">the whole series</a>.'|trans({
                    following_url: path('event_recurring_event_edit', {id: event.recurringEvent.id, from: event.occurrenceStart|date('Y-m-d')}),
                    series_url: path('event_recurring_event_edit', {id: event.recurringEvent.id}),
                })|raw }}
            {% endif %}
        </div>
    {% endif %}
    {% if notified_count > 0 and not event.cancelled %}
        <div class="alert alert-warning">
            <i class="fas fa-envelope"></i>
            {{ '{count, plural, one {# subscriber gets} other {# subscribers get}} an email when you change the date, time or location.'|trans({count: notified_count}) }}
        </div>
    {% endif %}
    {{ form(form) }}
{% endblock %}

{% block js %}
    {{ parent() }}
    {{ include('event/_duration_sync.html.twig') }}
{% endblock %}
