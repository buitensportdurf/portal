{% extends 'base/single.column.html.twig' %}

{% set title %}Edit {{ event }}{% endset %}

{% block actions %}
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-primary" href="{{ path('event_event_index') }}">Back to list</a>
        <a class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteEvent">Delete</a>
        {{ include('components/_confirm_modal.html.twig', {
            id: 'confirmDeleteEvent',
            title: 'Delete event',
            message: 'Are you sure you want to delete event "' ~ event ~ '"?',
            action_url: path('event_event_delete', {id: event.id}),
            csrf_id: 'event-delete',
            action_label: 'Delete',
        }) }}
    </div>
{% endblock %}

{% block body %}
    {% if event.recurringEvent %}
        <div class="alert alert-info">
            <i class="fas fa-redo"></i>
            This event is part of <strong>{{ event.recurringEvent }}</strong>. Changes here only apply to this event,
            and the fields you change stop following the series.
            {% if is_granted('ROLE_EVENT_RECURRING') and event.occurrenceStart %}
                To change more events, edit
                <a href="{{ path('event_recurring_event_edit', {id: event.recurringEvent.id, from: event.occurrenceStart|date('Y-m-d')}) }}">this and following events</a>
                or <a href="{{ path('event_recurring_event_edit', {id: event.recurringEvent.id}) }}">the whole series</a>.
            {% endif %}
        </div>
    {% endif %}
    {% if notified_count > 0 and not event.cancelled %}
        <div class="alert alert-warning">
            <i class="fas fa-envelope"></i>
            {{ notified_count }} subscriber(s) get an email when you change the date, time or location.
        </div>
    {% endif %}
    {{ form(form) }}
{% endblock %}

{% block js %}
    {{ parent() }}
    {{ include('event/_duration_sync.html.twig') }}
{% endblock %}
