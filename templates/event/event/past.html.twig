{% extends 'base/single.column.html.twig' %}

{% set title %}{{ 'Past events'|trans }}{% endset %}

{% block actions %}{% endblock %}

{% block body %}
    <div class="mb-3 d-flex gap-3 align-items-end">
        <div class="flex-grow-1">
            {% if years is not empty %}
                <small class="text-muted d-block mb-1">{{ 'Filter by year'|trans }}</small>
                {% for y in years %}
                    <a class="btn btn-sm {% if y == year %}btn-primary{% else %}btn-outline-primary{% endif %}"
                       href="{{ path('event_event_past', {year: y}) }}">{{ y }}</a>
                {% endfor %}
            {% endif %}
        </div>
        {{ include('event/event/_view_switch.html.twig') }}
    </div>

    {% if events is empty %}
        <div class="text-center py-5 text-muted">
            <p class="fs-5">{% if year %}{{ 'No past events in {year}'|trans({year: year ~ ''}) }}{% else %}{{ 'No past events'|trans }}{% endif %}</p>
        </div>
    {% else %}
        {{ include(view.template, {events: events}) }}
    {% endif %}
{% endblock %}
