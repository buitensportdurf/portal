{% extends 'base/single.column.html.twig' %}

{% set title %}{{ event }}{% endset %}

{% block actions %}
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-primary" href="{{ path('event_event_index') }}">{{ 'Back to list'|trans }}</a>
        {% if is_granted('ROLE_EVENT_EDIT') %}
            <a class="btn btn-outline-warning" href="{{ path('event_event_edit', {'id': event.id}) }}">{{ 'Edit'|trans }}</a>
            {% if is_granted('publish', event) %}
                <a class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#confirmPublish">{{ 'Publish'|trans }}</a>
                {{ include('components/_confirm_modal.html.twig', {
                    id: 'confirmPublish',
                    title: 'Publish event'|trans,
                    message: 'This will make "{event}" visible to all users and allow subscriptions.'|trans({event: event}),
                    action_url: path('event_event_publish', {id: event.id}),
                    csrf_id: 'event-publish',
                    action_label: 'Publish'|trans,
                    action_class: 'btn-success',
                }) }}
            {% elseif is_granted('unpublish', event) %}
                <a class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#confirmUnpublish">{{ 'Unpublish'|trans }}</a>
                {{ include('components/_confirm_modal.html.twig', {
                    id: 'confirmUnpublish',
                    title: 'Move to draft'|trans,
                    message: 'This will hide "{event}" from regular users. Events with subscribers cannot be unpublished.'|trans({event: event}),
                    action_url: path('event_event_unpublish', {id: event.id}),
                    csrf_id: 'event-publish',
                    action_label: 'Move to draft'|trans,
                    action_class: 'btn-secondary',
                }) }}
            {% endif %}
            {% if event.cancelled %}
                <a class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#confirmRestore">{{ 'Restore'|trans }}</a>
                {{ include('components/_confirm_modal.html.twig', {
                    id: 'confirmRestore',
                    title: 'Restore event'|trans,
                    message: 'This takes back the cancellation of "{event}". Subscribers are not emailed about this.'|trans({event: event}),
                    action_url: path('event_event_restore', {id: event.id}),
                    action_label: 'Restore'|trans,
                    action_class: 'btn-success',
                    csrf_id: 'event-restore-' ~ event.id,
                }) }}
            {% elseif event.startDate > date() %}
                <a class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmCancel">{{ 'Cancel event'|trans }}</a>
                {{ include('components/_confirm_modal.html.twig', {
                    id: 'confirmCancel',
                    title: 'Cancel event'|trans,
                    message: event.eventSubscriptions is empty
                        ? 'The event stays visible as cancelled and nobody can subscribe anymore.'|trans
                        : 'The event stays visible as cancelled and nobody can subscribe anymore. {count, plural, one {The # subscriber gets} other {The # subscribers get}} an email.'|trans({count: event.eventSubscriptions|length}),
                    action_url: path('event_event_cancel', {id: event.id}),
                    action_label: 'Cancel event'|trans,
                    csrf_id: 'event-cancel-' ~ event.id,
                }) }}
            {% endif %}
            <a class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteEvent">{{ 'Delete'|trans }}</a>
            {{ include('components/_confirm_modal.html.twig', {
                id: 'confirmDeleteEvent',
                title: 'Delete event'|trans,
                message: 'Are you sure you want to delete event "{event}"?'|trans({event: event}),
                action_url: path('event_event_delete', {id: event.id}),
                csrf_id: 'event-delete',
                action_label: 'Delete'|trans,
            }) }}
        {% endif %}
    </div>
{% endblock %}

{% block body %}
    {% if event.cancelled %}
        <div class="alert alert-danger">
            <i class="fas fa-ban"></i> {{ 'This event has been cancelled.'|trans }}
        </div>
    {% endif %}
    {% if event.recurringEvent and is_granted('ROLE_EVENT_RECURRING') %}
        {{ include('event/event/_series_panel.html.twig') }}
    {% endif %}
    {% if not event.published %}
        <div class="alert alert-secondary">
            <i class="fas fa-eye-slash"></i> {{ 'This event is a draft and not visible to regular users.'|trans }}
        </div>
    {% endif %}
    <div class="row g-4">
        <div class="col-md-4">
            {{ include('event/event/card.html.twig', {event: event}) }}
        </div>

        <div class="col-md-8">
            {# Event details card #}
            <div class="card mb-4">
                <div class="card-header">{{ 'Details'|trans }}</div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tbody>
                        {% if event.subscriptionOpenDate %}
                            <tr>
                                <th class="text-muted" style="width: 40%">{{ 'Subscriptions open'|trans }}</th>
                                <td>{{ event.subscriptionOpenDate|fdate_time }}</td>
                            </tr>
                        {% endif %}
                        {% if event.subscriptionDeadline %}
                            <tr>
                                <th class="text-muted">{{ 'Subscription deadline'|trans }}</th>
                                <td>{{ event.subscriptionDeadline|fdate }}</td>
                            </tr>
                        {% endif %}
                        {% if event.subscriberLimit > 0 %}
                            <tr>
                                <th class="text-muted">{{ 'Subscriber limit'|trans }}</th>
                                <td>{{ event.subscriberLimit }}</td>
                            </tr>
                        {% endif %}
                        {% if event.recurringEvent %}
                            <tr>
                                <th class="text-muted">{{ 'Repeats'|trans }}</th>
                                <td>{{ event.recurringEvent|recurrence_text }}</td>
                            </tr>
                        {% endif %}
                        <tr>
                            <th class="text-muted">{{ 'Price'|trans }}</th>
                            <td>
                                {% if event.memberPrice %}€ {{ event.memberPrice }}{% else %}{{ 'Free'|trans }}{% endif %}
                                {% if event.guestsAllowed and event.guestPrice %}
                                    <span class="text-muted">{{ '(guest: € {price})'|trans({price: event.guestPrice ~ ''}) }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted">{{ 'Access'|trans }}</th>
                            <td>
                                {% if event.guestsAllowed %}
                                    <span class="badge bg-success">{{ 'Open for guests'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ 'Members only'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {# Description card #}
            {% if event.description %}
                <div class="card mb-4">
                    <div class="card-header">{{ 'Description'|trans }}</div>
                    <div class="card-body">
                        {{ event.description|markdown_to_html }}
                    </div>
                </div>
            {% endif %}

            {# Subscribers card #}
            {% if is_granted('ROLE_USER') %}
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        {{ 'Subscribers'|trans }}
                        <span class="badge bg-primary rounded-pill">{{ event.amountOfSubscriptions }}</span>
                    </div>
                    {% if event.eventSubscriptions is empty %}
                        <div class="card-body text-muted">{{ 'No subscribers yet.'|trans }}</div>
                    {% else %}
                        <ol class="list-group list-group-flush">
                            {% for subscription in event.eventSubscriptions %}
                                <li class="list-group-item {% if subscription.createdUser is same as(app.user) %}list-group-item-success{% endif %}">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>{{ subscription.createdUser }}</strong>
                                            {% if subscription.createdUser.guest %}
                                                <span class="badge bg-secondary">{{ 'guest'|trans }}</span>
                                            {% endif %}
                                            <span class="badge bg-primary rounded-pill">{{ subscription.amount }}</span>
                                        </div>
                                        {% if is_granted('edit', subscription) %}
                                            <div class="btn-group btn-group-sm">
                                                <a class="btn btn-outline-warning"
                                                   href="{{ path('event_subscription_edit', {'id': subscription.id}) }}">{{ 'Edit'|trans }}</a>
                                                {% if is_granted('ROLE_EVENT_ADMIN') %}
                                                    <a class="btn btn-outline-danger" data-bs-toggle="modal"
                                                       data-bs-target="#confirmUnsubscribe{{ subscription.id }}">{{ 'Unsubscribe'|trans }}</a>
                                                    {{ include('components/_confirm_modal.html.twig', {
                                                        id: 'confirmUnsubscribe' ~ subscription.id,
                                                        title: 'Unsubscribe {name}'|trans({name: subscription.createdUser}),
                                                        message: 'Are you sure you want to unsubscribe "{name}" from "{event}"?'|trans({name: subscription.createdUser, event: event}),
                                                        action_url: path('event_subscription_unsubscribe', {id: subscription.id}),
                                                        csrf_id: 'unsubscribe',
                                                        action_label: 'Unsubscribe'|trans,
                                                    }) }}
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                    {% if subscription.note %}
                                        <div class="mt-1 small text-muted">
                                            {{ subscription.note|nl2br }}
                                        </div>
                                    {% endif %}
                                    {% for question in event.questions %}
                                        <div class="mt-1 small">
                                            <strong>{{ question }}:</strong> {{ question.answers[subscription.id] ?? '-' }}
                                        </div>
                                    {% endfor %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                </div>
            {% endif %}

            {# Subscriber emails (admin) #}
            {% if is_granted('ROLE_EVENT_ADMIN') %}
                <div class="card mb-4">
                    <div class="card-header">
                        <a class="text-decoration-none" data-bs-toggle="collapse" href="#collapseEmails"
                           role="button" aria-expanded="false" aria-controls="collapseEmails">
                            {{ 'Subscriber emails'|trans }}
                        </a>
                    </div>
                    <div class="collapse" id="collapseEmails">
                        <div class="card-body">
                            {% for subscription in event.eventSubscriptions %}
                                {{ subscription.createdUser.email }}<br>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Questions card #}
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    {{ 'Questions'|trans }}
                    {% if is_granted('ROLE_EVENT_EDIT') %}
                        <a class="btn btn-sm btn-outline-primary"
                           href="{{ path('event_question_create', {'id': event.id}) }}">{{ 'Add question'|trans }}</a>
                    {% endif %}
                </div>
                {% if event.questions is empty %}
                    <div class="card-body text-muted">{{ 'No questions configured.'|trans }}</div>
                {% else %}
                    <ol class="list-group list-group-flush">
                        {% for question in event.questions %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                {{ question }}
                                {% if is_granted('ROLE_EVENT_EDIT') %}
                                    <div class="btn-group btn-group-sm">
                                        <a class="btn btn-outline-warning"
                                           href="{{ path('event_question_edit', {'id': question.id}) }}">{{ 'Edit'|trans }}</a>
                                        <a class="btn btn-outline-danger" data-bs-toggle="modal"
                                           data-bs-target="#confirmDeleteQuestion{{ question.id }}">{{ 'Delete'|trans }}</a>
                                    </div>
                                    {{ include('components/_confirm_modal.html.twig', {
                                        id: 'confirmDeleteQuestion' ~ question.id,
                                        title: 'Delete question'|trans,
                                        message: 'Delete the question "{question}" and all answers to it?'|trans({question: question}),
                                        action_url: path('event_question_delete', {id: question.id}),
                                        action_label: 'Delete'|trans,
                                        csrf_id: 'question-delete',
                                    }) }}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
