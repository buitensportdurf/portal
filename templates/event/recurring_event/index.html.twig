{% extends 'base/single.column.html.twig' %}

{% set title %}{{ 'Recurring events'|trans }}{% endset %}

{% block actions %}
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-primary" href="{{ path('event_event_index') }}">{{ 'Back to events'|trans }}</a>
        <a class="btn btn-outline-success" href="{{ path('event_recurring_event_new') }}">{{ 'Create new'|trans }}</a>
    </div>
{% endblock %}

{% block body %}
    {% if recurringEvents is empty %}
        <div class="text-center py-5 text-muted">
            <p class="fs-5">{{ 'No recurring events'|trans }}</p>
        </div>
    {% else %}
        <div class="list-group">
            {% for recurringEvent in recurringEvents %}
                {% set next = next_occurrences(recurringEvent, 1)|first %}
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                   href="{{ path('event_recurring_event_show', {id: recurringEvent.id}) }}">
                    <div>
                        <strong>{{ recurringEvent }}</strong>
                        {% if not recurringEvent.published %}<span class="badge bg-secondary">{{ 'Draft'|trans }}</span>{% endif %}
                        <div class="small text-muted">
                            {{ recurringEvent|recurrence_text(true)|trans }}, {{ recurringEvent.startDate|date('H:i') }}
                        </div>
                    </div>
                    <span class="small text-muted text-end">
                        {% if next %}{{ 'Next: {date}'|trans({date: next|fdate}) }}{% else %}{{ 'Ended'|trans }}{% endif %}
                    </span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
