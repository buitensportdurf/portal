{% extends 'base/single.column.html.twig' %}

{% set title %}Edit {{ recurringEvent }}{% endset %}

{% block actions %}
    <div class="btn-group btn-group-sm">
        <a class="btn btn-outline-primary" href="{{ path('event_recurring_event_show', {id: recurringEvent.id}) }}">Back</a>
        <a class="btn btn-outline-danger" href="{{ path('event_recurring_event_delete', {id: recurringEvent.id}) }}">Delete series</a>
    </div>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-lg-7">
            {{ include('event/recurring_event/_form.html.twig', {preview_url: path('event_recurring_event_preview', {id: recurringEvent.id})}) }}
        </div>
        <div class="col-lg-5">
            <div class="card sticky-top" style="top: 1rem; max-height: calc(100vh - 2rem); overflow-y: auto">
                <div class="card-header">What saving will do</div>
                <div class="card-body" id="recurring-preview">
                    {% if plan %}
                        {{ include('event/recurring_event/_preview.html.twig', {plan: plan, errors: [], isNew: false}) }}
                    {% else %}
                        <p class="text-muted mb-0">Fix the form to see the changes.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block js %}
    {{ parent() }}
    {{ include('event/_duration_sync.html.twig') }}
    {{ include('event/recurring_event/_form_js.html.twig') }}
{% endblock %}
