{% extends 'base/single.column.html.twig' %}

{% set title %}Delete {{ recurringEvent }}{% endset %}

{% block actions %}
    <a class="btn btn-sm btn-outline-primary" href="{{ path('event_recurring_event_show', {id: recurringEvent.id}) }}">Back</a>
{% endblock %}

{% block body %}
    {% set Type = enum('App\\Recurrence\\Plan\\ChangeType') %}
    {% set deletes = plan.ofType(Type.Delete) %}
    {% set cancels = plan.ofType(Type.Cancel) %}
    <div class="card">
        <div class="card-body">
            <p>Deleting the series:</p>
            <ul>
                <li><strong>Deletes {{ deletes|length }} upcoming event(s)</strong> without subscribers.</li>
                {% if cancels %}
                    <li>
                        <strong>Cancels {{ cancels|length }} upcoming event(s)</strong> that have subscribers:
                        {% for change in cancels %}{{ change.slot|date('j M Y') }} ({{ change.subscriberCount }}){% if not loop.last %}, {% endif %}{% endfor %}.
                        They stay visible as cancelled.
                    </li>
                {% endif %}
                <li>Keeps {{ recurringEvent.pastEvents|length }} past event(s) as standalone events.</li>
            </ul>
            <p class="text-muted small">Want it to just stop at some point instead? Edit the series and set an end date.</p>
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('recurring-delete-' ~ recurringEvent.id) }}">
                {% if cancels %}
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" name="notify" value="1" id="notify" checked>
                        <label class="form-check-label" for="notify">Email the {{ plan.notifiedSubscriberCount }} subscriber(s) about the cancellation</label>
                    </div>
                {% endif %}
                <button class="btn btn-danger">Delete series</button>
                <a class="btn btn-secondary" href="{{ path('event_recurring_event_show', {id: recurringEvent.id}) }}">Cancel</a>
            </form>
        </div>
    </div>
{% endblock %}
