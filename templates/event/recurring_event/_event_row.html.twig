{# @var event App\Entity\Event\Event #}
<a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center{% if event.cancelled %} text-decoration-line-through text-muted{% endif %}"
   href="{{ path('event_event_show', {id: event.id}) }}">
    <span>
        {{ event.startDate|date('D j M Y H:i') }}
        {% if event.name != recurringEvent.name %}<span class="text-muted">· {{ event.name }}</span>{% endif %}
    </span>
    <span>
        {% if event.cancelled %}<span class="badge bg-danger">Cancelled</span>{% endif %}
        {% if not event.published %}<span class="badge bg-secondary">Draft</span>{% endif %}
        {% if event.overriddenFields %}
            <span class="badge bg-light text-dark border" title="Customised: {{ event.getOverriddenFields|map(f => f.label)|join(', ') }}">
                <i class="fas fa-lock"></i> {{ event.overriddenFields|length }} customised
            </span>
        {% endif %}
        {% if event.amountOfSubscriptions > 0 %}
            <span class="badge bg-primary"><i class="fas fa-users"></i> {{ event.amountOfSubscriptions }}</span>
        {% endif %}
    </span>
</a>
