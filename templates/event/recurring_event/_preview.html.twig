{# @var plan App\Recurrence\Plan\SeriesPlan #}
{% set Type = enum('App\\Recurrence\\Plan\\ChangeType') %}
{% set Field = enum('App\\Recurrence\\SeriesField') %}
{% macro subscribers(change) %}
    {% if change.subscriberCount > 0 %}
        <span class="badge bg-warning text-dark ms-1" title="{{ 'Subscribers'|trans }}"><i class="fas fa-users"></i> {{ change.subscriberCount }}</span>
    {% endif %}
{% endmacro %}

{% macro date_list(changes, limit = 6) %}
    {% for change in changes|slice(0, limit) %}
        <li>{{ change.slot|fdate }}{{ _self.subscribers(change) }}</li>
    {% endfor %}
    {% if changes|length > limit %}
        <li class="text-muted">{{ 'and {count} more'|trans({count: changes|length - limit}) }}</li>
    {% endif %}
{% endmacro %}

{% if errors %}
    <div class="alert alert-warning mb-0">
        <strong>{{ 'Fix the form to see the changes'|trans }}</strong>
        <ul class="mb-0 small">
            {% for error in errors %}<li>{{ error }}</li>{% endfor %}
        </ul>
    </div>
{% elseif isNew %}
    {% set creates = plan.ofType(Type.Create) %}
    <p class="mb-2"><strong>{{ 'Repeats {rule}'|trans({rule: plan.target|recurrence_text|trans}) }}</strong></p>
    {% if creates is empty %}
        <p class="text-muted mb-0">{{ 'This rule produces no events in the next 12 months.'|trans }}</p>
    {% else %}
        <p class="mb-1">{{ 'Saving creates <strong>{count, plural, one {# event} other {# events}}</strong> (12 months ahead, more are added automatically):'|trans({count: creates|length})|raw }}</p>
        <ul class="small mb-0">{{ _self.date_list(creates, 8) }}</ul>
    {% endif %}
{% elseif plan.isEmpty %}
    <p class="text-muted mb-0">
        {{ 'No changes yet. As you edit the form, this list shows exactly what saving will do to the upcoming events.'|trans }}
    </p>
{% else %}
    {% if plan.splitAt %}
        <div class="alert alert-info small py-2">
            <i class="fas fa-code-branch"></i>
            {{ 'Splits the series: events before <strong>{date}</strong> keep the current settings, a new series takes over from that date.'|trans({date: plan.splitAt|fdate_short})|raw }}
        </div>
    {% endif %}

    {% if plan.seriesChanges %}
        <h6>{{ 'Series'|trans }}</h6>
        <table class="table table-sm small">
            {% for change in plan.seriesChanges %}
                <tr>
                    <th class="text-nowrap">{{ change.label|trans }}</th>
                    <td><s class="text-muted">{{ change.old|trans }}</s><br>{{ change.new|trans }}</td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {% set notifications = plan.notifications %}
    {% if notifications %}
        <div class="alert alert-warning small py-2">
            <i class="fas fa-envelope"></i>
            {{ '{subscribers, plural, one {# subscriber} other {# subscribers}} of {events, plural, one {# event} other {# events}} get an email about the change (unless you switch that off below).'|trans({subscribers: plan.notifiedSubscriberCount, events: notifications|length}) }}
        </div>
    {% endif %}

    <h6>{{ 'Upcoming events'|trans }}</h6>
    {% if not plan.hasOccurrenceChanges and plan.keptOverrides is empty %}
        <p class="small text-muted">{{ 'None of the upcoming events change.'|trans }}</p>
    {% endif %}
    <ul class="list-unstyled small">
        {% set moves = plan.ofType(Type.Move) %}
        {% if moves %}
            <li class="mb-2">
                <i class="fas fa-arrows-alt-h fa-fw text-primary"></i> <strong>{{ '{count} moved'|trans({count: moves|length}) }}</strong>
                <ul>
                    {% for change in moves|slice(0, 6) %}
                        {% set schedule = change.change(Field.Schedule) %}
                        <li>
                            <s class="text-muted">{{ schedule.oldText|trans }}</s> → {{ schedule.newText|trans }}{{ _self.subscribers(change) }}
                            {% set others = change.changes|filter(c => not c.field.relativeToStart) %}
                            {% if others %}
                                <span class="text-muted">+ {{ others|map(c => (c.field.label|trans) ~ ': ' ~ (c.newText|trans))|join(', ') }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                    {% if moves|length > 6 %}<li class="text-muted">{{ 'and {count} more'|trans({count: moves|length - 6}) }}</li>{% endif %}
                </ul>
            </li>
        {% endif %}

        {% for group in plan.groupedUpdates %}
            <li class="mb-2">
                <i class="fas fa-pen fa-fw text-primary"></i> <strong>{{ '{count} updated'|trans({count: group.occurrences|length}) }}</strong>
                <ul>
                    {% for change in group.changes %}
                        <li>
                            {{ change.field.label|trans }}:
                            {% if change.field.relativeToStart %}
                                {{ 'recalculated, e.g. <s class="text-muted">{old}</s> → {new}'|trans({old: change.oldText|trans|e, new: change.newText|trans|e})|raw }}
                            {% else %}
                                <s class="text-muted">{{ change.oldText|trans }}</s> → {{ change.newText|trans }}
                            {% endif %}
                        </li>
                    {% endfor %}
                    <li class="text-muted">
                        {% for change in group.occurrences|slice(0, 4) %}{{ change.slot|fday_month }}{% if not loop.last %}, {% endif %}{% endfor %}{% if group.occurrences|length > 4 %} …{% endif %}
                    </li>
                </ul>
            </li>
        {% endfor %}

        {% set creates = plan.ofType(Type.Create) %}
        {% if creates %}
            <li class="mb-2">
                <i class="fas fa-plus fa-fw text-success"></i> <strong>{{ '{count} new'|trans({count: creates|length}) }}</strong>
                <ul>{{ _self.date_list(creates) }}</ul>
            </li>
        {% endif %}

        {% set cancels = plan.ofType(Type.Cancel) %}
        {% if cancels %}
            <li class="mb-2">
                <i class="fas fa-ban fa-fw text-danger"></i> <strong>{{ '{count} cancelled'|trans({count: cancels|length}) }}</strong>
                <span class="text-muted">{{ '(they have subscribers, so they stay visible as cancelled)'|trans }}</span>
                <ul>{{ _self.date_list(cancels) }}</ul>
            </li>
        {% endif %}

        {% set deletes = plan.ofType(Type.Delete) %}
        {% if deletes %}
            <li class="mb-2">
                <i class="fas fa-trash fa-fw text-danger"></i> <strong>{{ '{count} deleted'|trans({count: deletes|length}) }}</strong>
                <span class="text-muted">{{ '(no subscribers)'|trans }}</span>
                <ul>{{ _self.date_list(deletes) }}</ul>
            </li>
        {% endif %}

        {% set kept = plan.keptOverrides %}
        {% if kept %}
            <li class="mb-2">
                <i class="fas fa-lock fa-fw text-secondary"></i> <strong>{{ '{count, plural, one {# keeps its own settings} other {# keep their own settings}}'|trans({count: kept|length}) }}</strong>
                <span class="text-muted">{{ '(customised on the event itself)'|trans }}</span>
                <ul>
                    {% for change in kept %}
                        <li>
                            {{ change.slot|fdate }}:
                            {{ change.keptOverrides|map(field => field.label|trans)|join(', ') }}
                        </li>
                    {% endfor %}
                </ul>
            </li>
        {% endif %}
    </ul>

    {% set unchanged = plan.count(Type.Unchanged) - plan.keptOverrides|filter(c => c.type == Type.Unchanged)|length %}
    {% if unchanged > 0 %}
        <p class="small text-muted mb-0">{{ '{count, plural, one {# other upcoming event stays as it is.} other {# other upcoming events stay as they are.}}'|trans({count: unchanged}) }}</p>
    {% endif %}
{% endif %}
