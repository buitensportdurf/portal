{# @var form Symfony\Component\Form\FormView #}
{% macro offset_row(field) %}
    <div class="mb-3">
        <label class="form-label" for="{{ field.amount.vars.id }}">{{ field.vars.label|trans }}</label>
        <div class="input-group">
            {{ form_widget(field.amount, {attr: {class: 'flex-grow-0', style: 'width: 6rem'}}) }}
            {{ form_widget(field.unit) }}
        </div>
        {{ form_errors(field) }}
        {% if field.vars.help %}<div class="form-text">{{ field.vars.help|trans }}</div>{% endif %}
    </div>
{% endmacro %}

{% set rule = form.rrule %}
{{ form_start(form, {attr: {id: 'recurring-form', 'data-preview-url': preview_url}}) }}
<div class="card mb-3">
    <div class="card-header">{{ 'Schedule'|trans }}</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">{{ form_row(form.startDate) }}</div>
            <div class="col-md-6">{{ form_row(form.endDate) }}</div>
        </div>
        {{ form_errors(rule) }}
        <div class="row">
            <div class="col-md-5">{{ form_row(rule.frequency) }}</div>
            <div class="col-md-4">
                {{ form_label(rule.interval) }}
                <div class="input-group">
                    {{ form_widget(rule.interval) }}
                    <span class="input-group-text" data-interval-unit>{{ 'weeks'|trans }}</span>
                </div>
                {{ form_errors(rule.interval) }}
            </div>
        </div>
        <div class="mt-3" data-show-frequency="WEEKLY">
            {{ form_label(rule.weekdays) }}
            <div class="d-flex flex-wrap gap-3">
                {% for day in rule.weekdays %}
                    {{ form_widget(day) }}
                {% endfor %}
            </div>
            <div class="form-text">{{ rule.weekdays.vars.help|trans }}</div>
        </div>
        <div class="mt-3" data-show-frequency="MONTHLY">
            {{ form_row(rule.monthlyMode) }}
            <div class="row g-2 mb-3" data-show-monthly-mode="weekday">
                <div class="col-auto">{{ form_widget(rule.ordinal) }}</div>
                <div class="col-auto">{{ form_widget(rule.weekday) }}</div>
                <div class="col-auto align-self-center">{{ 'of the month'|trans }}</div>
            </div>
        </div>
        <div class="mt-3">
            {{ form_row(rule.end) }}
            <div class="row">
                <div class="col-md-5" data-show-end="until">{{ form_row(rule.until) }}</div>
                <div class="col-md-5" data-show-end="count">{{ form_row(rule.count) }}</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">{{ 'Details'|trans }}</div>
    <div class="card-body">
        {{ form_row(form.name) }}
        {{ form_row(form.location) }}
        {{ form_row(form.description) }}
        {{ form_row(form.tags) }}
        {{ form_row(form.image) }}
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">{{ 'Subscriptions'|trans }}</div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">{{ _self.offset_row(form.subscriptionOpenOffset) }}</div>
            <div class="col-md-6">{{ _self.offset_row(form.subscriptionDeadlineOffset) }}</div>
        </div>
        <div class="row">
            <div class="col-md-4">{{ form_row(form.subscriberLimit) }}</div>
            <div class="col-md-4">{{ form_row(form.memberPrice) }}</div>
            <div class="col-md-4">{{ form_row(form.guestPrice) }}</div>
        </div>
        {{ form_row(form.guestsAllowed) }}
        {{ form_row(form.published) }}
    </div>
</div>

{% if form.applyFrom is defined or form.notifySubscribers is defined %}
    <div class="card mb-3 border-primary">
        <div class="card-header">{{ 'Apply'|trans }}</div>
        <div class="card-body">
            {% if form.applyFrom is defined %}{{ form_row(form.applyFrom) }}{% endif %}
            {% if form.notifySubscribers is defined %}{{ form_row(form.notifySubscribers) }}{% endif %}
        </div>
    </div>
{% endif %}

{{ form_row(form.save, {attr: {class: 'btn-primary'}}) }}
{{ form_end(form) }}
