{% extends 'base/single.column.html.twig' %}

{% set title %}{{ '{name} profile'|trans({name: app.user.name}) }}{% endset %}

{% block body %}
    <div class="row">
        <div class="col-sm">
            <b>{{ 'Id:'|trans }}</b> {{ app.user.id }} <br/>
            <b>{{ 'Username:'|trans }}</b> {{ app.user.username }} <br/>
{#            {% if is_granted('ROLE_API') %}#}
{#                Your api key: {{ app.user.apiKey }} <a class="btn btn-primary" href="{{ path('user_apikey_generate') }}">Regenerate</a> <br/>#}
{#            {% endif %}#}
            <br/>
            {% if is_granted('ROLE_ADMIN') %}
                <br/><br/>
                <h3>{{ 'Latest release stats'|trans }}</h3>
                {{ 'Branch:'|trans }} {{ release.branch }} <br/>
                {{ 'Date:'|trans }} {{ release.date }} <br/>
                {{ 'Hash short:'|trans }} {{ release.commitHashShort }} <br/>
                {{ 'Hash long:'|trans }} {{ release.commitHashLong }} <br/>
                {{ 'Commit date:'|trans }} {{ release.commitDate }} <br/>
            {% endif %}
        </div>
        <div class="col-sm">
            <h3>{{ 'Change profile'|trans }}</h3>
            {{ form(form) }}
        </div>
    </div>
{% endblock %}