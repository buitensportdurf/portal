{% use 'bootstrap_5_layout.html.twig' %}

{% block form_start -%}
    {% set attr = attr|merge({novalidate: 'novalidate'}) %}
    {{- parent() -}}
{%- endblock form_start %}

{%- block vich_image_widget -%}
    <div class="vich-image">
        {%- if errors|length > 0 -%}
            {%- set attr = attr|merge({class: (attr.class|default('') ~ ' is-invalid')|trim}) -%}
        {%- endif -%}
        {{- form_widget(form.file, {attr: attr}) -}}
        {%- if form.delete is defined -%}
            {{- form_row(form.delete) -}}
        {%- endif -%}

        {%- if image_uri -%}
            <a href="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" download>
                <img src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" alt="" style="max-width: 300px; max-height: 200px;" class="mt-2 rounded" />
            </a>
        {%- endif -%}
        {%- if download_uri -%}
            <a href="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}" download class="btn btn-sm btn-outline-secondary mt-2">
                <i class="fas fa-download me-1"></i>
                {{ download_label_translation_domain is same as(false) ? download_label : download_label|trans({}, download_label_translation_domain) }}
            </a>
        {%- endif -%}
    </div>
{%- endblock -%}

{# Multiple expanded choices as toggle pills, for short lists such as event tags #}
{%- block tag_pills_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' d-flex flex-wrap gap-2')|trim}) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form -%}
            <input type="checkbox" class="btn-check" autocomplete="off"
                   id="{{ child.vars.id }}" name="{{ child.vars.full_name }}" value="{{ child.vars.value }}"
                   {%- if child.vars.checked %} checked{% endif %}{% if child.vars.disabled %} disabled{% endif %}>
            <label class="btn btn-sm btn-outline-primary rounded-pill" for="{{ child.vars.id }}">{{ child.vars.label }}</label>
            {%- do child.setRendered -%}
        {%- endfor -%}
    </div>
{%- endblock tag_pills_widget -%}

